# Database (SQLite - no setup required)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/app.db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Viral Video Intelligence

# Backend
NODE_ENV=development
PORT=5000
API_SECRET_KEY=your-secret-key-here

# AI/ML APIs
OPENAI_API_KEY=sk-...  # For Whisper (captions)
HIGGSFIELD_API_KEY=hf_...  # For virality prediction
CLAUDE_API_KEY=sk-ant-...  # For idea generation & analysis

# AWS S3
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=viral-videos-uploads
AWS_REGION=eu-central-1

# Authentication (optional - use Clerk or Auth0)
AUTH_SECRET=your-auth-secret
NEXT_AUTH_URL=http://localhost:3000

# FFmpeg & Whisper
FFMPEG_PATH=/usr/bin/ffmpeg
WHISPER_MODEL=base  # tiny, base, small, medium, large

# Trending Content API (optional)
TIKTOK_API_KEY=...
YOUTUBE_API_KEY=...
